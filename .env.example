# Copy to .env (git-ignored). Nothing here is required to run the test suite.

# RPC. Public endpoints work for reads and dry runs; use the CDP Node RPC key for crons and the
# keeper, and an archive endpoint for mainnet-fork replays.
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Verification on Basescan (both networks use one key).
BASESCAN_API_KEY=

# Deployer keys. Sepolia: ETH + Circle USDC from the faucets. Mainnet: ETH for the oracle, market,
# pre-liquidation, desk and vault deploys. Keep the keeper on its own key. Never reuse a key that
# holds the team's AAPLc positions for automated jobs.
SEPOLIA_DEPLOYER_KEY=
MAINNET_DEPLOYER_KEY=
KEEPER_KEY=

# Owners for Ownable2Step contracts (acceptOwnership is required after deploy). Defaults to the
# broadcaster when unset.
CALENDAR_OWNER=
ORACLE_OWNER=
SIMULATOR_OWNER=

# Cloudflare (wrangler reads CLOUDFLARE_API_TOKEN; bindings live in each app's wrangler.jsonc).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Coinbase Developer Platform: paymaster policy URLs (Sepolia and mainnet) and the Node RPC key.
CDP_PAYMASTER_URL_SEPOLIA=
CDP_PAYMASTER_URL_MAINNET=
CDP_NODE_RPC_KEY=

# Builder Code from dashboard.base.org (ERC-8021 calldata suffix).
BASE_BUILDER_CODE=
