{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boundline-agent",
  // Served at https://agent.boundline.xyz (a Workers Custom Domain on the boundline.xyz zone); workers.dev stays on.
  "routes": [{ "pattern": "agent.boundline.xyz", "custom_domain": true }],
  // Keep the workers.dev URL: the submission, the docs and the other services link to it. Without this line,
  // declaring a route turns workers.dev off.
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The agent surface reaches the other Workers through service bindings (workers.dev fetches between Workers are
  // refused with Cloudflare error 1042). The partner key for `quote` and `shadowHealth` is the secret PARTNER_API_KEY.
  "services": [
    { "binding": "API", "service": "boundline-api" },
    { "binding": "INDEXER", "service": "boundline-indexer" },
    { "binding": "OBSERVATORY", "service": "boundline-observatory" },
    { "binding": "KEEPER", "service": "boundline-keeper" }
  ],
  "vars": {
    "BASE_RPC_URL": "https://base-rpc.publicnode.com,https://base.drpc.org,https://mainnet.base.org",
    "BASE_SEPOLIA_RPC_URL": "https://sepolia.base.org,https://base-sepolia-rpc.publicnode.com,https://base-sepolia.drpc.org",
    "PARTNER_ID": "boundline-app",
    // x402 on the REST aliases (POST /v1/tools/:name) for callers without a partner key: $0.01 USDC on Base Sepolia per
    // call through the public facilitator, paid to the deployer (as on the partner API). MCP (POST /mcp) stays free.
    "X402_ENABLED": "true",
    "X402_PAY_TO": "0x2f0d9B1f16CD702259C6cC259e8D5E5455282a4E",
    "X402_FACILITATOR": "https://x402.org/facilitator",
    "X402_NETWORK": "base-sepolia",
    "X402_PRICE_USDC": "0.01"
  },
  "observability": { "enabled": true }
}
