{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boundline-indexer",
  // Served at https://indexer.boundline.xyz (a Workers Custom Domain on the boundline.xyz zone). Keep workers.dev too:
  // declaring a route turns it off otherwise.
  "routes": [{ "pattern": "indexer.boundline.xyz", "custom_domain": true }],
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boundline-indexer",
      // Create it once with `pnpm exec wrangler d1 create boundline-indexer` and paste the id here.
      "database_id": "dde9a6a8-e474-43a0-a809-b7f5e2e91ca4",
      "migrations_dir": "migrations"
    }
  ],
  // RPCs in fallback order (first answers, the rest fall back). Measured 6 Oct 2026 for eth_getLogs with the real request
  // shapes: Tenderly's public gateway serves 500-block windows back to September (max 1,000); mainnet.base.org caps the
  // range at 500 and rate-limits Cloudflare egress; publicnode refuses "archive" ranges and multi-address filters; drpc's free
  // plan and Alchemy's free tier (10-block windows) are unusable for log scans. Sepolia: sepolia.base.org caps at 500,
  // publicnode serves 2,000. Keyed RPCs go in the secrets BASE_RPC_URL_PRIVATE / BASE_SEPOLIA_RPC_URL_PRIVATE (tried first).
  // INDEX_MAINNET turns on the six phase-2 Base mainnet sources (feeds, OracleRegistry, B20 tokens, Morpho B20 markets, Aave spoke,
  // the B20 PolicyRegistry for the seize watch). Tick budget: per source at most MAX_RANGES_PER_TICK ranges of 500 blocks, per tick
  // at most MAX_RANGES_TOTAL_PER_TICK ranges and MAX_LOGS_PER_TICK decoded logs; the source order rotates every minute.
  // MAINNET_FEEDS_START_BLOCK reaches back to ~22 Sep 2026. Sized on 8 Oct 2026 for the Free plan: since the raw-RPC rewrite a
  // warm tick of 12 ranges and 24 logs costs ~1 ms CPU in Node (bench: scripts/bench-tick.ts), but live every fetch and
  // every D1 round trip costs CPU too: one commit per tick and parallel ranges took a tick from 24-43 ms to 11-13 ms
  // (16 ranges), and near-head sources now wait MIN_LAG_BLOCKS (tick.ts). 12 ranges + 2 heads + a few header reads +
  // 5 reconciliation reads also stays under the plan's 50 subrequests per invocation.
  "vars": {
    "BASE_RPC_URL": "https://base.gateway.tenderly.co,https://gateway.tenderly.co/public/base,https://mainnet.base.org,https://base-rpc.publicnode.com",
    "BASE_SEPOLIA_RPC_URL": "https://sepolia.base.org,https://base-sepolia-rpc.publicnode.com",
    "CREDIT_DESK_SEPOLIA": "0x39aBaDc0aAa12D1F7e259b89536Aa1848997399a",
    "INDEX_MAINNET": "true",
    "MAINNET_START_BLOCK": "52198000",
    "MAINNET_FEEDS_START_BLOCK": "51640000",
    "MAX_RANGES_PER_TICK": "6",
    "MAX_RANGES_TOTAL_PER_TICK": "12",
    "MAX_LOGS_PER_TICK": "150",
    // Stored events hashed per tick for the daily roots (src/tick.ts ROOT_HASHES_PER_TICK); a cold isolate pays ~1 ms each.
    "ROOT_HASHES_PER_TICK": "8"
  },
  "observability": { "enabled": true }
}
