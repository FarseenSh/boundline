{
  "name": "@boundline/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "The Boundline indexer: a Cloudflare Worker that pulls Morpho, Aave, B20, OracleRegistry, Chainlink and Boundline events into D1 with hash-chained daily roots and a reconciliation job.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@boundline/calendar": "workspace:*",
    "@boundline/chain": "workspace:*",
    "hono": "4.13.12",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "wrangler": "4.147.0"
  }
}
