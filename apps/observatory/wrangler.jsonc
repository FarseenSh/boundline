{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boundline-observatory",
  // Served at https://observatory.boundline.xyz (a Workers Custom Domain on the boundline.xyz zone); workers.dev stays on.
  "routes": [{ "pattern": "observatory.boundline.xyz", "custom_domain": true }],
  // Keep the workers.dev URL: the submission, the docs and the other services link to it. Without this line,
  // declaring a route turns workers.dev off.
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // One cron a minute: the snapshot, the reopen capture, the indexer kick, and on every fifth minute the real-position
  // scan. A second trigger ("*/5 * * * *") was deployed on 6 Oct 2026 and never fired in 14 minutes on this account
  // (the indexer's own cron never fired either), so src/index.ts gates the positions job on the wall-clock minute instead.
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "SNAPSHOTS", "id": "aa7d8b27e629463da60008acfeccc30d" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boundline-observatory",
      "database_id": "dce1418d-1356-40ba-b6a8-5915ddbd95a7",
      "migrations_dir": "migrations"
    }
  ],
  // R2 is off: the account's wrangler login has no r2 scope and exports are not built yet. To turn it on, run
  // `wrangler r2 bucket create boundline-observatory-exports` with an R2-scoped login and add
  // "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "boundline-observatory-exports" }]; the code treats EXPORTS as optional.
  // Public RPCs in fallback order (mainnet.base.org rate-limits Cloudflare egress, so it is last; Blast was dropped on 3 Oct 2026 when it began failing every call). A keyed RPC goes in the secret BASE_RPC_URL_PRIVATE.
  "vars": { "BASE_RPC_URL": "https://base-rpc.publicnode.com,https://base.drpc.org,https://mainnet.base.org" },
  // Service binding to the indexer: its cron is called from here as a fallback (Worker-to-Worker fetches over workers.dev are refused, error 1042).
  "services": [{ "binding": "INDEXER", "service": "boundline-indexer" }],
  "observability": { "enabled": true }
}
