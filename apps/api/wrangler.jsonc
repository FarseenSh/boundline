{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boundline-api",
  // Served at https://api.boundline.xyz (a Workers Custom Domain on the boundline.xyz zone); workers.dev stays on.
  "routes": [{ "pattern": "api.boundline.xyz", "custom_domain": true }],
  // Keep the workers.dev URL: the submission, the docs and the other services link to it. Without this line,
  // declaring a route turns workers.dev off.
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every minute: poll the indexer for the desk's and the protection contracts' events (webhooks) and retry due
  // deliveries. Scheduled invocations are killed at 10 ms of CPU on the Free plan, so a tick is bounded: at most ten new
  // events per source and five retries, the cursor saved as it goes (src/webhooks.ts, pollSource).
  "triggers": { "crons": ["* * * * *"] },
  // Service bindings: Worker-to-Worker fetches over workers.dev are refused (error 1042). The indexer serves events,
  // timelines and roots; the Observatory serves the Base mainnet tokens and Morpho markets POST /v1/route reads on 8453.
  "services": [
    { "binding": "INDEXER", "service": "boundline-indexer" },
    { "binding": "OBSERVATORY", "service": "boundline-observatory" }
  ],
  // Create with `pnpm exec wrangler d1 create boundline-api`, paste the id here, then
  // `pnpm exec wrangler d1 migrations apply boundline-api --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boundline-api",
      "database_id": "9dee89e3-b1bd-42b3-b91c-adbcf9f58da9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CHAIN_ID": "84532",
    // Both answered eth_chainId 0x14a34 on 3 Oct 2026; the first is tried first.
    "BASE_SEPOLIA_RPC_URL": "https://sepolia.base.org,https://base-sepolia-rpc.publicnode.com",
    // The Sepolia CreditDesk (deployments/base-sepolia.json); empty would make desk routes answer 503.
    "CREDIT_DESK": "0x39aBaDc0aAa12D1F7e259b89536Aa1848997399a",
    "MORPHO": "0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb",
    "SESSION_GATE": "0x92f59437d4ef5CDcEAe2CcDE89B03A7B4B1Ae427",
    "INDEXER_URL": "https://boundline-indexer.papermind-ai.workers.dev",
    // The desk's markets (deployments/base-sepolia.json): policy rows, symbols, and the protection contracts where
    // protected mode is live (the AAPLt pre-liquidation with the ShadowGuard oracle and Boundline's Protector).
    "MARKETS": "[{\"symbol\":\"AAPLt\",\"collateral\":\"0xB2000000000000000000000E063E65377cA34141\",\"marketId\":\"0x4a03b124a170a913931f00ab87f7966d388370cf457c0a3c4fb6fcf4fbb88047\",\"preLiquidation\":\"0xdcae709341aab652144e8afcb47479fe49e133a1\",\"protector\":\"0x5c546946c909718040dd686f63df6cb5e4df442c\",\"targetLtvWad\":\"580000000000000000\"},{\"symbol\":\"NVDAt\",\"collateral\":\"0xB200000000000000000000AEd76Eae58870E2ae6\",\"marketId\":\"0x7cb7fcc828a7296f8ea18256e0f5763a5588cfe22df9c943088021c762e58cc9\"},{\"symbol\":\"TSLAt\",\"collateral\":\"0xb200000000000000000000Af3FB2181a8772F804\",\"marketId\":\"0xb0e8d25d1c9b822cc718c89666b887698922a7b49fdb00dbdecd70dd4ed9e2f1\"}]",
    // x402 metering (plan M7): POST /v1/quotes and GET /v1/positions/:addr/shadow cost $0.01 USDC on Base Sepolia
    // for callers without a partner key, settled through the public facilitator. Partners with a key are never metered.
    "X402_ENABLED": "true",
    "X402_PAY_TO": "0x2f0d9B1f16CD702259C6cC259e8D5E5455282a4E",
    "X402_FACILITATOR": "https://x402.org/facilitator",
    "X402_NETWORK": "base-sepolia",
    "X402_PRICE_USDC": "0.01",
    // POST /v1/route on Base mainnet: IRM rates over public RPCs in fallback order (mainnet.base.org rate-limits
    // Cloudflare egress, so it is last). The DeskProtectionVault makes every desk line protected ("vault") at any hour.
    "BASE_RPC_URL": "https://base-rpc.publicnode.com,https://base.drpc.org,https://mainnet.base.org",
    "DESK_PROTECTION_VAULT": "0x87f600279F021ca859b9903DE884d3A7A169f38c",
    // Deliveries to this host go to the app itself (a Worker fetching its own workers.dev URL gets error 1042).
    "PUBLIC_HOST": "boundline-api.papermind-ai.workers.dev"
    // Secret (not set: pending the human's approval of a new key): ROUTE_SIGNER_KEY signs route plans.
  }
}
